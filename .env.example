# Local development: copy to .env (ignored by git). Production values are set
# by the deploy script and the server's env file, never committed.
DEBUG=True
# Optional when DEBUG=True; required when DEBUG=False.
SECRET_KEY=
# Comma-separated. Defaults cover production hosts plus localhost.
# ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_DOMAIN=
LOG_LEVEL=INFO

# Booking emails. With DEBUG=True they are printed to the console; in
# production nothing is sent until EMAIL_HOST_PASSWORD is set (via the
# EMAIL_HOST_PASSWORD GitHub secret, which the deploy script writes to
# clinic.env). A Resend API key (re_...) implies smtp.resend.com, user
# "resend" and booking@blessandjoywellness.com as sender; any other value is
# used as a Gmail app password for blessandjoywellness@gmail.com. The
# remaining settings only need setting to override those defaults.
# EMAIL_HOST_PASSWORD=
# EMAIL_HOST=
# EMAIL_HOST_USER=
# DEFAULT_FROM_EMAIL=
# BOOKING_NOTIFY_EMAIL=blessandjoywellness@gmail.com
