# Local development: copy to .env (ignored by git). Production values are set
# by the deploy script and the server's env file, never committed.
DEBUG=True
# Optional when DEBUG=True; required when DEBUG=False.
SECRET_KEY=
# Comma-separated. Defaults cover production hosts plus localhost.
# ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_DOMAIN=
LOG_LEVEL=INFO

# Booking emails. With DEBUG=True they are printed to the console; in
# production nothing is sent until EMAIL_HOST_PASSWORD is set (via the
# EMAIL_* GitHub secrets, which the deploy script writes to clinic.env).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=blessandjoywellness@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=blessandjoywellness@gmail.com
# BOOKING_NOTIFY_EMAIL=blessandjoywellness@gmail.com
